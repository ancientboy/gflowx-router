new file mode 100644
index 00000000..6ec8a4d7
--- /dev/null
+++ b/gflowxscene/alias.go
@@ -0,0 +1,93 @@
+package gflowxscene
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+const envAliasesEnabled = "GFLOWX_ALIASES_ENABLED"
+const envAliasesFile = "GFLOWX_ALIASES_FILE"
+
+// AliasesEnabled is on by default; set GFLOWX_ALIASES_ENABLED=false to disable.
+func AliasesEnabled() bool {
+	v := strings.TrimSpace(strings.ToLower(os.Getenv(envAliasesEnabled)))
+	return v != "false" && v != "0" && v != "off"
+}
+
+// builtinAliases match docs/API.md (friendly id → concrete upstream model name).
+var builtinAliases = map[string]string{
+	"claude":   "claude-sonnet-4-20250514",
+	"gpt4":     "gpt-4o",
+	"deepseek": "deepseek-chat",
+}
+
+type aliasesFile struct {
+	mu    sync.Mutex
+	path  string
+	mtime time.Time
+	data  map[string]string
+}
+
+var aliasesCache aliasesFile
+
+func loadAliasFile() map[string]string {
+	path := strings.TrimSpace(os.Getenv(envAliasesFile))
+	if path == "" {
+		return nil
+	}
+	st, err := os.Stat(path)
+	if err != nil {
+		return nil
+	}
+	aliasesCache.mu.Lock()
+	defer aliasesCache.mu.Unlock()
+	if aliasesCache.path == path && !st.ModTime().After(aliasesCache.mtime) && aliasesCache.data != nil {
+		return aliasesCache.data
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var m map[string]string
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return nil
+	}
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		ak := strings.ToLower(strings.TrimSpace(k))
+		av := strings.TrimSpace(v)
+		if ak != "" && av != "" {
+			out[ak] = av
+		}
+	}
+	aliasesCache.path = path
+	aliasesCache.mtime = st.ModTime()
+	aliasesCache.data = out
+	return out
+}
+
+// ResolveAlias maps a friendly alias to a concrete model when enabled.
+func ResolveAlias(model string) (resolved string, ok bool) {
+	if !AliasesEnabled() {
+		return "", false
+	}
+	key := strings.ToLower(strings.TrimSpace(model))
+	if key == "" {
+		return "", false
+	}
+	if IsSceneTag(key) {
+		return "", false
+	}
+	if f := loadAliasFile(); f != nil {
+		if v, hit := f[key]; hit {
+			return v, true
+		}
+	}
+	if v, hit := builtinAliases[key]; hit {
+		return v, true
+	}
+	return "", false
+}
diff --git a/gflowxscene/apply.go b/gflowxscene/apply.go
new file mode 100644
index 00000000..24bcbc9f
--- /dev/null
+++ b/gflowxscene/apply.go
@@ -0,0 +1,145 @@
+package gflowxscene
+
+import (
+	"strings"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+
+	"github.com/gin-gonic/gin"
+)
+
+const (
+	ctxKeyPoolModels = "gflowx_scene_pool_models"
+	ctxKeyPoolIdx    = "gflowx_scene_pool_index"
+)
+
+func syncOriginalModel(c *gin.Context, resolved string) {
+	if c == nil || resolved == "" {
+		return
+	}
+	common.SetContextKey(c, constant.ContextKeyOriginalModel, resolved)
+}
+
+func clearScenePool(c *gin.Context) {
+	if c == nil {
+		return
+	}
+	c.Set(ctxKeyPoolModels, nil)
+	c.Set(ctxKeyPoolIdx, 0)
+}
+
+func attachScenePool(c *gin.Context, models []string) {
+	if c == nil || len(models) <= 1 {
+		clearScenePool(c)
+		return
+	}
+	dup := append([]string(nil), models...)
+	c.Set(ctxKeyPoolModels, dup)
+	c.Set(ctxKeyPoolIdx, 0)
+}
+
+func getRequestModel(req dto.Request) string {
+	switch r := req.(type) {
+	case *dto.GeneralOpenAIRequest:
+		return r.Model
+	case *dto.OpenAIResponsesRequest:
+		return r.Model
+	case *dto.ClaudeRequest:
+		return r.Model
+	default:
+		return ""
+	}
+}
+
+func setModelOnRequest(req dto.Request, name string) bool {
+	switch r := req.(type) {
+	case *dto.GeneralOpenAIRequest:
+		r.SetModelName(name)
+		return true
+	case *dto.OpenAIResponsesRequest:
+		r.SetModelName(name)
+		return true
+	case *dto.ClaudeRequest:
+		r.SetModelName(name)
+		return true
+	default:
+		return false
+	}
+}
+
+// ApplyToRequest resolves GFlowX aliases (docs/API.md) then scene tags, mutating the request model.
+// When c is non-nil, syncs ContextKeyOriginalModel so downstream InitChannelMeta keeps the resolved id.
+func ApplyToRequest(c *gin.Context, req dto.Request) (userLabel string, resolvedModel string, changed bool) {
+	if req == nil {
+		return "", "", false
+	}
+	raw := getRequestModel(req)
+	if raw == "" {
+		return "", "", false
+	}
+	rawTrim := strings.TrimSpace(raw)
+	if AliasesEnabled() {
+		if to, ok := ResolveAlias(rawTrim); ok {
+			if setModelOnRequest(req, to) {
+				clearScenePool(c)
+				syncOriginalModel(c, to)
+				return rawTrim, to, true
+			}
+		}
+	}
+	if !Enabled() {
+		return "", "", false
+	}
+	tag := strings.ToLower(rawTrim)
+	if _, is := sceneTags[tag]; !is {
+		return "", "", false
+	}
+	models := sceneCandidateModels(tag)
+	resolved := firstHealthyModel(models)
+	if resolved == "" {
+		return "", "", false
+	}
+	if !setModelOnRequest(req, resolved) {
+		return "", "", false
+	}
+	attachScenePool(c, models)
+	syncOriginalModel(c, resolved)
+	return rawTrim, resolved, true
+}
+
+// TryAdvancePool moves to the next model in a scene pool (if any) and updates relay state.
+func TryAdvancePool(c *gin.Context, req dto.Request, relayInfo *relaycommon.RelayInfo) bool {
+	if c == nil || req == nil || relayInfo == nil {
+		return false
+	}
+	v, ok := c.Get(ctxKeyPoolModels)
+	if !ok || v == nil {
+		return false
+	}
+	models, ok := v.([]string)
+	if !ok || len(models) <= 1 {
+		return false
+	}
+	idx := 0
+	if iv, ok2 := c.Get(ctxKeyPoolIdx); ok2 {
+		if n, conv := iv.(int); conv {
+			idx = n
+		}
+	}
+	if idx+1 >= len(models) {
+		return false
+	}
+	idx++
+	c.Set(ctxKeyPoolIdx, idx)
+	next := models[idx]
+	relayInfo.OriginModelName = next
+	syncOriginalModel(c, next)
+	if !setModelOnRequest(req, next) {
+		return false
+	}
+	relayInfo.ChannelMeta = nil
+	return true
+}
diff --git a/gflowxscene/health.go b/gflowxscene/health.go
new file mode 100644
index 00000000..33757135
--- /dev/null
+++ b/gflowxscene/health.go
@@ -0,0 +1,63 @@
+package gflowxscene
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const envHealthEnabled = "GFLOWX_SCENE_HEALTH_ENABLED"
+const envHealthTTL = "GFLOWX_SCENE_HEALTH_TTL_SEC"
+
+var unhealthy sync.Map // model name -> unix expiry
+
+// HealthTrackingEnabled is on by default; set GFLOWX_SCENE_HEALTH_ENABLED=false to disable.
+func HealthTrackingEnabled() bool {
+	v := strings.TrimSpace(strings.ToLower(os.Getenv(envHealthEnabled)))
+	return v != "false" && v != "0" && v != "off"
+}
+
+func healthTTL() time.Duration {
+	v := strings.TrimSpace(os.Getenv(envHealthTTL))
+	if n, err := strconv.Atoi(v); err == nil && n > 0 {
+		return time.Duration(n) * time.Second
+	}
+	return 60 * time.Second
+}
+
+// MarkModelUnhealthy records a transient failure for a concrete upstream model id.
+// Subsequent scene pool selection skips it until TTL elapses.
+func MarkModelUnhealthy(model string) {
+	if !HealthTrackingEnabled() {
+		return
+	}
+	model = strings.TrimSpace(model)
+	if model == "" {
+		return
+	}
+	unhealthy.Store(model, time.Now().Add(healthTTL()).UnixNano())
+}
+
+// IsModelHealthy reports whether model is not under a recent failure mark.
+func IsModelHealthy(model string) bool {
+	model = strings.TrimSpace(model)
+	if model == "" {
+		return true
+	}
+	v, ok := unhealthy.Load(model)
+	if !ok {
+		return true
+	}
+	exp, ok := v.(int64)
+	if !ok {
+		unhealthy.Delete(model)
+		return true
+	}
+	if time.Now().UnixNano() < exp {
+		return false
+	}
+	unhealthy.Delete(model)
+	return true
+}
diff --git a/gflowxscene/pool.go b/gflowxscene/pool.go
new file mode 100644
index 00000000..a487782f
--- /dev/null
+++ b/gflowxscene/pool.go
@@ -0,0 +1,65 @@
+package gflowxscene
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+const envPoolsFile = "GFLOWX_SCENE_POOLS_FILE"
+
+type poolsFile struct {
+	mu    sync.Mutex
+	path  string
+	mtime time.Time
+	data  map[string][]string
+}
+
+var poolsCache poolsFile
+
+func loadScenePools() map[string][]string {
+	path := strings.TrimSpace(os.Getenv(envPoolsFile))
+	if path == "" {
+		return nil
+	}
+	st, err := os.Stat(path)
+	if err != nil {
+		return nil
+	}
+	poolsCache.mu.Lock()
+	defer poolsCache.mu.Unlock()
+	if poolsCache.path == path && !st.ModTime().After(poolsCache.mtime) && poolsCache.data != nil {
+		return poolsCache.data
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	var m map[string][]string
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return nil
+	}
+	out := make(map[string][]string, len(m))
+	for k, v := range m {
+		tag := strings.ToLower(strings.TrimSpace(k))
+		if tag == "" {
+			continue
+		}
+		var list []string
+		for _, item := range v {
+			s := strings.TrimSpace(item)
+			if s != "" {
+				list = append(list, s)
+			}
+		}
+		if len(list) > 0 {
+			out[tag] = list
+		}
+	}
+	poolsCache.path = path
+	poolsCache.mtime = st.ModTime()
+	poolsCache.data = out
+	return out
+}
diff --git a/gflowxscene/resolve.go b/gflowxscene/resolve.go
new file mode 100644
index 00000000..1b707b8b
--- /dev/null
+++ b/gflowxscene/resolve.go
@@ -0,0 +1,105 @@
+// Package gflowxscene maps GFlowX scene tags (docs/API.md) to concrete upstream model names
+// before new-api channel selection and relay.
+package gflowxscene
+
+import (
+	"os"
+	"strings"
+)
+
+const envEnabled = "GFLOWX_SCENES_ENABLED"
+
+// sceneTags are exact `model` values treated as scenes (lowercase).
+var sceneTags = map[string]struct{}{
+	"smart":     {},
+	"fast":      {},
+	"cheap":     {},
+	"code":      {},
+	"write":     {},
+	"creative":  {},
+	"vision":    {},
+	"translate": {},
+}
+
+// builtinDefault is used when no per-tag env override is set.
+func builtinDefault(tag string) string {
+	switch tag {
+	case "smart", "write", "creative", "vision":
+		return "gpt-4o"
+	case "fast", "cheap", "translate":
+		return "gpt-4o-mini"
+	case "code":
+		return "gpt-4o"
+	default:
+		return "gpt-4o-mini"
+	}
+}
+
+func envSceneModel(tag string) string {
+	u := strings.ToUpper(strings.ReplaceAll(tag, "-", "_"))
+	key := "GFLOWX_SCENE_" + u
+	if v := strings.TrimSpace(os.Getenv(key)); v != "" {
+		return v
+	}
+	return ""
+}
+
+// Enabled returns whether scene resolution runs (default true; set GFLOWX_SCENES_ENABLED=false to disable).
+func Enabled() bool {
+	v := strings.TrimSpace(strings.ToLower(os.Getenv(envEnabled)))
+	return v != "false" && v != "0" && v != "off"
+}
+
+// IsSceneTag reports whether the given model string is a known scene label.
+func IsSceneTag(model string) bool {
+	if model == "" {
+		return false
+	}
+	_, ok := sceneTags[strings.ToLower(strings.TrimSpace(model))]
+	return ok
+}
+
+func sceneCandidateModels(tagLower string) []string {
+	if v := envSceneModel(tagLower); v != "" {
+		return []string{v}
+	}
+	if m := loadScenePools(); m != nil {
+		if list, ok := m[tagLower]; ok && len(list) > 0 {
+			return append([]string(nil), list...)
+		}
+	}
+	return []string{builtinDefault(tagLower)}
+}
+
+func firstHealthyModel(models []string) string {
+	if len(models) == 0 {
+		return ""
+	}
+	if !HealthTrackingEnabled() {
+		return models[0]
+	}
+	for _, m := range models {
+		if IsModelHealthy(m) {
+			return m
+		}
+	}
+	return models[0]
+}
+
+// Resolve maps a scene tag to the first concrete model name (env > pool file > builtin), honoring health marks.
+// ok is false when model is not a scene tag or scene routing is disabled.
+func Resolve(model string) (resolved string, ok bool) {
+	if !Enabled() {
+		return "", false
+	}
+	tag := strings.ToLower(strings.TrimSpace(model))
+	if _, is := sceneTags[tag]; !is {
+		return "", false
+	}
+	models := sceneCandidateModels(tag)
+	out := firstHealthyModel(models)
+	if out == "" {
+		return "", false
+	}
+	return out, true
+}
