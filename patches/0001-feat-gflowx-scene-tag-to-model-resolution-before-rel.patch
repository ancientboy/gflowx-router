+package gflowxscene
+
+import (
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/QuantumNous/new-api/dto"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestResolve_Disabled(t *testing.T) {
+	t.Setenv(envEnabled, "false")
+	if _, ok := Resolve("code"); ok {
+		t.Fatal("expected no resolve when disabled")
+	}
+}
+
+func TestResolve_CodeDefault(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	t.Setenv("GFLOWX_SCENE_CODE", "")
+	_ = os.Unsetenv(envPoolsFile)
+	got, ok := Resolve("code")
+	if !ok || got != "gpt-4o" {
+		t.Fatalf("code: got %q ok=%v", got, ok)
+	}
+}
+
+func TestResolve_CodeEnvOverride(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	t.Setenv("GFLOWX_SCENE_CODE", "deepseek-chat")
+	_ = os.Unsetenv(envPoolsFile)
+	got, ok := Resolve("code")
+	if !ok || got != "deepseek-chat" {
+		t.Fatalf("code override: got %q ok=%v", got, ok)
+	}
+}
+
+func TestApplyToRequest_GeneralOpenAI(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	_ = os.Unsetenv("GFLOWX_SCENE_FAST")
+	req := &dto.GeneralOpenAIRequest{Model: "fast"}
+	tag, resolved, changed := ApplyToRequest(nil, req)
+	if !changed || tag != "fast" || resolved != "gpt-4o-mini" {
+		t.Fatalf("ApplyToRequest: tag=%q resolved=%q changed=%v model=%q", tag, resolved, changed, req.Model)
+	}
+	if req.Model != "gpt-4o-mini" {
+		t.Fatalf("request not mutated: %q", req.Model)
+	}
+}
+
+func TestResolve_NotAScene(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	if _, ok := Resolve("gpt-4o-mini"); ok {
+		t.Fatal("concrete model must not be treated as scene")
+	}
+}
+
+func TestResolveAlias_Builtin(t *testing.T) {
+	t.Setenv(envAliasesEnabled, "true")
+	got, ok := ResolveAlias("claude")
+	if !ok || got != "claude-sonnet-4-20250514" {
+		t.Fatalf("alias claude: got %q ok=%v", got, ok)
+	}
+}
+
+func TestApplyToRequest_AliasBeforeScene(t *testing.T) {
+	t.Setenv(envAliasesEnabled, "true")
+	t.Setenv(envEnabled, "true")
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	req := &dto.GeneralOpenAIRequest{Model: "claude"}
+	user, resolved, changed := ApplyToRequest(c, req)
+	if !changed || user != "claude" || resolved != "claude-sonnet-4-20250514" {
+		t.Fatalf("alias apply: user=%q resolved=%q changed=%v", user, resolved, changed)
+	}
+	if req.Model != "claude-sonnet-4-20250514" {
+		t.Fatalf("model: %q", req.Model)
+	}
+}
+
+func TestResolve_PoolFileFirst(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	_ = os.Unsetenv("GFLOWX_SCENE_CODE")
+	dir := t.TempDir()
+	p := filepath.Join(dir, "pools.json")
+	if err := os.WriteFile(p, []byte(`{"code":["alpha-model","beta-model"]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(envPoolsFile, p)
+	got, ok := Resolve("code")
+	if !ok || got != "alpha-model" {
+		t.Fatalf("pool first: got %q ok=%v", got, ok)
+	}
+}
+
+func TestResolve_PoolSkipsUnhealthy(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	_ = os.Unsetenv("GFLOWX_SCENE_CODE")
+	t.Setenv(envHealthEnabled, "true")
+	dir := t.TempDir()
+	p := filepath.Join(dir, "pools.json")
+	if err := os.WriteFile(p, []byte(`{"code":["bad-model","good-model"]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(envPoolsFile, p)
+	MarkModelUnhealthy("bad-model")
+	got, ok := Resolve("code")
+	if !ok || got != "good-model" {
+		t.Fatalf("expected good-model, got %q ok=%v", got, ok)
+	}
+}
+
+func TestTryAdvancePool(t *testing.T) {
+	t.Setenv(envEnabled, "true")
+	_ = os.Unsetenv("GFLOWX_SCENE_CODE")
+	dir := t.TempDir()
+	p := filepath.Join(dir, "pools.json")
+	if err := os.WriteFile(p, []byte(`{"code":["m1","m2"]}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(envPoolsFile, p)
+	w := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(w)
+	req := &dto.GeneralOpenAIRequest{Model: "code"}
+	if _, _, changed := ApplyToRequest(c, req); !changed || req.Model != "m1" {
+		t.Fatalf("expected first pool model m1, got %q changed=%v", req.Model, changed)
+	}
+	info := &relaycommon.RelayInfo{OriginModelName: req.Model}
+	if !TryAdvancePool(c, req, info) {
+		t.Fatal("TryAdvancePool expected true")
+	}
+	if req.Model != "m2" || info.OriginModelName != "m2" {
+		t.Fatalf("after advance: req=%q origin=%q", req.Model, info.OriginModelName)
+	}
+	if TryAdvancePool(c, req, info) {
+		t.Fatal("expected no third model")
+	}
+}
