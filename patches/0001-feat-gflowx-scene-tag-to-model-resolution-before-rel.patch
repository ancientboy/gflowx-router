+++ b/gflowxscene/resolve.go
@@ -0,0 +1,105 @@
+// Package gflowxscene maps GFlowX scene tags (docs/API.md) to concrete upstream model names
+// before new-api channel selection and relay.
+package gflowxscene
+
+import (
+	"os"
+	"strings"
+)
+
+const envEnabled = "GFLOWX_SCENES_ENABLED"
+
+// sceneTags are exact `model` values treated as scenes (lowercase).
+var sceneTags = map[string]struct{}{
+	"smart":     {},
+	"fast":      {},
+	"cheap":     {},
+	"code":      {},
+	"write":     {},
+	"creative":  {},
+	"vision":    {},
+	"translate": {},
+}
+
+// builtinDefault is used when no per-tag env override is set.
+func builtinDefault(tag string) string {
+	switch tag {
+	case "smart", "write", "creative", "vision":
+		return "gpt-4o"
+	case "fast", "cheap", "translate":
+		return "gpt-4o-mini"
+	case "code":
+		return "gpt-4o"
+	default:
+		return "gpt-4o-mini"
+	}
+}
+
+func envSceneModel(tag string) string {
+	u := strings.ToUpper(strings.ReplaceAll(tag, "-", "_"))
+	key := "GFLOWX_SCENE_" + u
+	if v := strings.TrimSpace(os.Getenv(key)); v != "" {
+		return v
+	}
+	return ""
+}
+
+// Enabled returns whether scene resolution runs (default true; set GFLOWX_SCENES_ENABLED=false to disable).
+func Enabled() bool {
+	v := strings.TrimSpace(strings.ToLower(os.Getenv(envEnabled)))
+	return v != "false" && v != "0" && v != "off"
+}
+
+// IsSceneTag reports whether the given model string is a known scene label.
+func IsSceneTag(model string) bool {
+	if model == "" {
+		return false
+	}
+	_, ok := sceneTags[strings.ToLower(strings.TrimSpace(model))]
+	return ok
+}
+
+func sceneCandidateModels(tagLower string) []string {
+	if v := envSceneModel(tagLower); v != "" {
+		return []string{v}
+	}
+	if m := loadScenePools(); m != nil {
+		if list, ok := m[tagLower]; ok && len(list) > 0 {
+			return append([]string(nil), list...)
+		}
+	}
+	return []string{builtinDefault(tagLower)}
+}
+
+func firstHealthyModel(models []string) string {
+	if len(models) == 0 {
+		return ""
+	}
+	if !HealthTrackingEnabled() {
+		return models[0]
+	}
+	for _, m := range models {
+		if IsModelHealthy(m) {
+			return m
+		}
+	}
+	return models[0]
+}
+
+// Resolve maps a scene tag to the first concrete model name (env > pool file > builtin), honoring health marks.
+// ok is false when model is not a scene tag or scene routing is disabled.
+func Resolve(model string) (resolved string, ok bool) {
+	if !Enabled() {
+		return "", false
+	}
+	tag := strings.ToLower(strings.TrimSpace(model))
+	if _, is := sceneTags[tag]; !is {
+		return "", false
+	}
+	models := sceneCandidateModels(tag)
+	out := firstHealthyModel(models)
+	if out == "" {
+		return "", false
+	}
+	return out, true
+}
